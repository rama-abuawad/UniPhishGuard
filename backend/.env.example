APP_ENV=development
ALLOWED_ORIGINS=https://your-addin-site.example.com
MAX_REQUEST_BYTES=8000000
RATE_LIMIT_MAX_REQUESTS=30
HISTORY_RETENTION_DAYS=30
HISTORY_ITEM_LIMIT=50
MAX_ATTACHMENT_BYTES=5000000
MAX_ZIP_ENTRIES=50
MAX_ZIP_UNCOMPRESSED_BYTES=20000000
HISTORY_HMAC_SECRET=replace-with-at-least-32-random-characters-in-production
REQUIRE_AUTH=false

# Optional comma-separated organization overrides.
# APPROVED_SENDER_DOMAINS=adu.ac.ae,info.adu.ac.ae,students.adu.ac.ae
# APPROVED_LINK_DOMAINS=adu.ac.ae,students.adu.ac.ae
# Required in production. Use only authserv-id values verified in headers added
# by the organization's inbound mail gateways.
# TRUSTED_AUTHSERV_IDS=verified-gateway.example.edu

# Temporary demo auth. Do not put this value in static frontend files for production.
# UNIPHISHGUARD_API_TOKEN=development-only-shared-token

# Preferred production auth. Configure these from the Microsoft Entra app registration.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
