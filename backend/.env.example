ALLOWED_ORIGINS=https://your-addin-site.example.com
MAX_REQUEST_BYTES=250000
RATE_LIMIT_MAX_REQUESTS=30
REQUIRE_AUTH=true

# Temporary demo auth. Do not put this value in static frontend files for production.
UNIPHISHGUARD_API_TOKEN=change-this-local-demo-token

# Preferred production auth. Configure these from the Microsoft Entra app registration.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
